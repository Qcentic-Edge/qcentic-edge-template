# Copy this file to .env.docker.prod and fill in the values.
# Usage: docker compose -f docker-compose.prod.yml --env-file .env.docker.prod up
# Add --profile bundled-db to also run a local libSQL server (sqld) — useful
# for testing the prod image on your machine. Real production on bunny.net
# uses Bunny Database: link the DB to your Magic Container app and bunny
# injects BUNNY_DATABASE_URL + BUNNY_DATABASE_AUTH_TOKEN (those are picked
# up automatically; the DB_URL / DB_AUTH_TOKEN below take precedence).

APP_NAME=Filament
APP_ENV=production
APP_DEBUG=false
# Generate once and keep it stable forever (sessions/cookies are encrypted with it):
#   php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
APP_KEY=
APP_URL=http://localhost:8080

LOG_CHANNEL=stderr
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=reverb

# PHP publishes to the reverb service; Echo uses the published host port.
# Rebuild the image after changing VITE_REVERB_* (baked at npm run build).
REVERB_APP_ID=1001
REVERB_APP_KEY=laravel-reverb-key
REVERB_APP_SECRET=laravel-reverb-secret
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_HOST_PORT=8081
VITE_REVERB_APP_KEY=laravel-reverb-key
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8081
VITE_REVERB_SCHEME=http

# Remote libSQL database:
#   Bunny Database: libsql://[id].lite.bunnydb.net (token via dashboard)
#   Turso:          libsql://[db].turso.io
#   Local sqld:     http://db:8080 (with --profile bundled-db)
DB_CONNECTION=libsql
DB_URL=
# Bearer token for the remote DB (empty for a local sqld without auth).
DB_AUTH_TOKEN=

# Host port for the app
HTTP_PORT=8080
# Published app image to run, e.g. <registry-user>/my-base-filament-template:latest
IMAGE_NAME=

# Object storage. MinIO is local-dev only (docker-compose.dev.yml). Production
# uses Bunny Storage S3 / AWS / R2: set FILESYSTEM_DISK=s3 and the AWS_* keys.
# Multi-replica must also set LIVEWIRE_TEMPORARY_FILE_UPLOAD_DISK=s3.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_ENDPOINT=
# AWS_USE_PATH_STYLE_ENDPOINT=false
# Public object URLs (Storage::url). Empty = bucket endpoint.
# Private objects use temporaryUrl() against AWS_ENDPOINT — not this URL.
# AWS_URL=
# Runtime prefix for asset() / Vite / Filament published files. Empty = app origin.
# Do not set Vite `base` to a CDN; the image stays target-agnostic.
# ASSET_URL=
# LIVEWIRE_TEMPORARY_FILE_UPLOAD_DISK=s3
