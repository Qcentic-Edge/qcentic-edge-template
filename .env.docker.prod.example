# Copy this file to .env.docker.prod and fill in the values.
# Usage: docker compose -f docker-compose.prod.yml --env-file .env.docker.prod up
# Add --profile bundled-db to also run a local Postgres container.
# Without that profile the app talks to whatever DB_HOST points at,
# e.g. a managed database (Bunny CDN, DigitalOcean, Supabase, ...).

APP_NAME=Filament
APP_ENV=production
APP_DEBUG=false
# Generate once and keep it stable forever (sessions/cookies are encrypted with it):
#   php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
APP_KEY=
APP_URL=http://localhost:8080

LOG_CHANNEL=stderr
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

DB_CONNECTION=pgsql
# External managed database host (leave unset when using --profile bundled-db,
# compose then defaults DB_HOST to the bundled db service).
DB_HOST=
DB_PORT=5432
DB_DATABASE=filament
DB_USERNAME=filament
# Used for both the app and (if enabled) the bundled Postgres container.
DB_PASSWORD=
# Managed databases usually require TLS: set to require/verify-full when needed.
# DB_SSLMODE=require

# Host port for the app
HTTP_PORT=8080
# Published app image to run, e.g. <registry-user>/my-base-filament-template:latest
IMAGE_NAME=
