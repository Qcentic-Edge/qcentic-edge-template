{
    "name": "mamenein/filament-installer",
    "description": "First-run web installer: env checklist plus one-click migrations, then locks itself.",
    "keywords": [
        "filament",
        "laravel",
        "installer",
        "deployment"
    ],
    "license": "proprietary",
    "version": "0.3.0",
    "authors": [
        {
            "name": "mamenein",
            "email": "73882408+mamenein@users.noreply.github.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Mamenein\\FilamentInstaller\\": "src/",
            "Mamenein\\FilamentInstaller\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mamenein\\FilamentInstaller\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mamenein\\FilamentInstaller\\FilamentInstallerServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "homepage": "https://github.com/Qcentic-Edge/filament-installer"
}
