{
    "name": "qcentic-edge/filament-installer",
    "description": "First-run web installer: env checklist plus one-click migrations, then locks itself.",
    "keywords": [
        "filament",
        "laravel",
        "installer",
        "deployment"
    ],
    "license": "proprietary",
    "version": "0.4.0",
    "authors": [
        {
            "name": "Qcentic Edge",
            "role": "Developer"
        }
    ],
    "repositories": [
        {
            "type": "path",
            "url": "../../libraries/plugin-updates"
        }
    ],
    "require": {
        "filament/filament": "^5.0",
        "php": "^8.3",
        "qcentic-edge/plugin-updates": "*",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "QcenticEdge\\FilamentInstaller\\": "src/",
            "QcenticEdge\\FilamentInstaller\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "QcenticEdge\\FilamentInstaller\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "QcenticEdge\\FilamentInstaller\\FilamentInstallerServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "homepage": "https://github.com/Qcentic-Edge/filament-installer"
}
