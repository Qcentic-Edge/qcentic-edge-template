{
    "name": "qcentic-edge/filament-media-drive",
    "description": "Filament 5 Drive-style media browser and picker field on Spatie Media Library (s3 disk).",
    "keywords": [
        "filament",
        "laravel",
        "media",
        "drive",
        "spatie"
    ],
    "homepage": "https://github.com/Qcentic-Edge/qcentic-edge-template",
    "license": "Apache-2.0",
    "version": "0.1.0",
    "authors": [
        {
            "name": "Qcentic Edge",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.0",
        "filament/spatie-laravel-media-library-plugin": "^5.0",
        "qcentic-edge/plugin-updates": "*",
        "spatie/laravel-medialibrary": "^11.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "autoload": {
        "psr-4": {
            "QcenticEdge\\FilamentMediaDrive\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "QcenticEdge\\FilamentMediaDrive\\MediaDriveServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
