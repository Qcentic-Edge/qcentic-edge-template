# Copy this file to .env.docker.dev and fill in the values.
# Usage: docker compose -f docker-compose.dev.yml --env-file .env.docker.dev up
#
# Project name is NOT read from this file. Copy `.env.example` → `.env`
# (or export COMPOSE_PROJECT_NAME). Default: qcentic-edge-template-dev.

# Public brand: Filament sidebar, mail from-name, HTML titles.
APP_NAME="Qcentic Edge Template"
APP_ENV=local
APP_DEBUG=true
# Generate once and keep it stable forever (sessions/cookies are encrypted with it):
#   php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
APP_KEY=
APP_URL=http://localhost:8090

LOG_CHANNEL=stderr
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=s3
BROADCAST_CONNECTION=reverb
# Single-container compose: Livewire temp stays on the local disk so browser
# uploads do not have to hit MinIO (PHP uses http://minio:9000, the browser
# uses http://localhost:9000 — rewriting a presigned host breaks SigV4).
# Multi-replica production must set LIVEWIRE_TEMPORARY_FILE_UPLOAD_DISK=s3.
LIVEWIRE_TEMPORARY_FILE_UPLOAD_DISK=local

# Same PHP image as app; browser Echo talks to the published host port.
REVERB_APP_ID=1001
REVERB_APP_KEY=laravel-reverb-key
REVERB_APP_SECRET=laravel-reverb-secret
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_HOST_PORT=8081
VITE_REVERB_APP_KEY=laravel-reverb-key
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8081
VITE_REVERB_SCHEME=http

# Optional Redis for Reverb scale-out. Default Reverb is in-memory.
# Laravel has no database persister for Reverb fan-out — Redis is required
# to run more than one Reverb replica. The queue may stay on `database`.
# Enable the service with: docker compose --profile redis
# REDIS_URL=redis://redis:6379
# REVERB_REDIS=redis://redis:6379
# REVERB_SCALING_ENABLED=true
# REDIS_HOST_PORT=6379

# Local libSQL server (sqld container) — same protocol as Bunny Database.
# Empty auth token: the local sqld runs without authentication.
DB_CONNECTION=libsql
DB_URL=http://db:8080
DB_AUTH_TOKEN=

# First-run installer (off locally if you seed by hand).
INSTALLER_ENABLED=false

# Host port for the app (http://localhost:8090)
HTTP_PORT=8090
# Host port for the Vite dev server (http://localhost:5173)
VITE_PORT=5173
# Host port to reach the local libSQL server from the outside
DB_HOST_PORT=8181

# Local MinIO (S3-compatible). Root user/password are also the AWS keys.
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=miniosecret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=miniosecret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=filament
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true
# Public object URLs (Storage::url). Empty = MinIO / bucket endpoint.
# Private objects use temporaryUrl() against AWS_ENDPOINT — not this URL.
# Dev minio-init sets anonymous GET on the bucket so these unsigned URLs load.
AWS_URL=http://localhost:9000/filament

# Runtime prefix for asset() / Vite / Filament published files. Empty = app origin.
# Do not set Vite `base` to a CDN; the image stays target-agnostic.
ASSET_URL=

# OAuth2 signing keys (PEM). Same class of secret as APP_KEY.
# Magic Containers have ephemeral disks — never leave keys only on disk.
# Full steps: see app/.env.example (Passport section).
#
# From repo root with compose up:
#   docker compose -f docker-compose.dev.yml --env-file .env.docker.dev exec app php artisan passport:keys
#   docker compose -f docker-compose.dev.yml --env-file .env.docker.dev exec app \
#     php -r 'echo str_replace(["\r\n","\n","\r"], "\\n", file_get_contents("storage/oauth-private.key"));'
#   (same for oauth-public.key → PASSPORT_PUBLIC_KEY)
#   docker compose -f docker-compose.dev.yml --env-file .env.docker.dev exec app \
#     rm storage/oauth-private.key storage/oauth-public.key
PASSPORT_PRIVATE_KEY=
PASSPORT_PUBLIC_KEY=
