# Copy this file to .env.docker.dev and fill in the values.
# Usage: docker compose -f docker-compose.dev.yml --env-file .env.docker.dev up

APP_NAME=Filament
APP_ENV=local
APP_DEBUG=true
# Generate once and keep it stable forever (sessions/cookies are encrypted with it):
#   php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
APP_KEY=
APP_URL=http://localhost:8090

LOG_CHANNEL=stderr
SESSION_DRIVER=database
CACHE_STORE=database
# Dev runs jobs synchronously; no queue worker needed.
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=filament
DB_USERNAME=filament
# Used for both the Postgres container and the app:
DB_PASSWORD=

# Host port for the app (http://localhost:8090)
HTTP_PORT=8090
# Host port for the Vite dev server (http://localhost:5173)
VITE_PORT=5173
# Host port to reach the dev Postgres from the outside (TablePlus, psql, ...)
DB_HOST_PORT=5432
