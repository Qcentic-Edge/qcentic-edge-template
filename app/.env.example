# Public brand: Filament sidebar, mail from-name, HTML titles.
APP_NAME="Qcentic Edge Template"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

REVERB_APP_ID=1001
REVERB_APP_KEY=laravel-reverb-key
REVERB_APP_SECRET=laravel-reverb-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Optional Redis for Reverb scale-out. Default Reverb is in-memory.
# Laravel has no database persister for Reverb fan-out — Redis is required
# to run more than one Reverb replica. The queue may stay on `database`.
# REDIS_URL=
# REVERB_REDIS=
# REVERB_SCALING_ENABLED=false

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Bunny Storage S3 — zone NAME → AWS_ACCESS_KEY_ID + AWS_BUCKET;
# zone PASSWORD → AWS_SECRET_ACCESS_KEY; region code (de/ny/…) → AWS_DEFAULT_REGION;
# AWS_ENDPOINT=https://{region}-s3.storage.bunnycdn.com; AWS_URL=pull-zone .b-cdn.net.
# Do NOT put URLs in REGION or BUCKET. See .env.docker.prod.example for a full example.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
# Public object URLs (Storage::url). Empty = bucket / MinIO endpoint.
# Private objects use temporaryUrl() against AWS_ENDPOINT — not this URL.
AWS_URL=
# Runtime prefix for asset() / Vite / Filament published files. Empty = app origin.
# Do not set Vite `base` to a CDN.
ASSET_URL=

# Livewire temp uploads. `local` is fine for a single app container; use `s3`
# on multi-replica production so the upload and form-submit can hit different pods.
LIVEWIRE_TEMPORARY_FILE_UPLOAD_DISK=local

VITE_APP_NAME="${APP_NAME}"

# OAuth2 signing keys (PEM). Same class of secret as APP_KEY.
# Magic Containers have ephemeral disks — never leave keys only on disk.
#
# Steps (run from this app/ directory — Laravel root, not the repo root):
#   1. php artisan passport:keys
#      Creates storage/oauth-private.key and storage/oauth-public.key
#   2. One-line paste (for Magic Containers / single-line env UIs):
#      php -r 'echo str_replace(["\r\n","\n","\r"], "\\n", file_get_contents("storage/oauth-private.key"));'
#      php -r 'echo str_replace(["\r\n","\n","\r"], "\\n", file_get_contents("storage/oauth-public.key"));'
#      Paste each output into PASSPORT_PRIVATE_KEY / PASSPORT_PUBLIC_KEY below
#      (keep -----BEGIN...----- / -----END...-----; \n escapes are fine).
#   3. Or paste multiline PEM in quotes (local .env only):
#      PASSPORT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
#   4. rm storage/oauth-private.key storage/oauth-public.key
#
# Docker shortcut (from repo root, with compose up):
#   docker compose -f docker-compose.dev.yml --env-file .env.docker.dev exec app php artisan passport:keys
#   docker compose -f docker-compose.dev.yml --env-file .env.docker.dev exec app \
#     php -r 'echo str_replace(["\r\n","\n","\r"], "\\n", file_get_contents("storage/oauth-private.key"));'
PASSPORT_PRIVATE_KEY=
PASSPORT_PUBLIC_KEY=
