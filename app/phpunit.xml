<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
            <exclude>tests/Feature/Api</exclude>
            <exclude>tests/Feature/Security</exclude>
        </testsuite>
        <testsuite name="Feature/Api">
            <directory>tests/Feature/Api</directory>
        </testsuite>
        <testsuite name="Feature/Security">
            <directory>tests/Feature/Security</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- force="true": the dev container exports real env vars (DB_CONNECTION=libsql,
             DB_URL=...) which PHPUnit would otherwise not override, silently pointing
             tests at the wrong database. -->
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_DEBUG" value="false" force="true"/>
        <env name="APP_KEY" value="base64:2fl+Ktvkfl+Fuz4Qp/Ej30lCI73AXvCD7U+FhCjqHiE=" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="DB_CONNECTION" value="sqlite" force="true"/>
        <env name="DB_DATABASE" value=":memory:" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <env name="FILESYSTEM_DISK" value="local" force="true"/>
        <env name="LIVEWIRE_TEMPORARY_FILE_UPLOAD_DISK" value="local" force="true"/>
        <env name="AWS_ACCESS_KEY_ID" value="minio" force="true"/>
        <env name="AWS_SECRET_ACCESS_KEY" value="miniosecret" force="true"/>
        <env name="AWS_DEFAULT_REGION" value="us-east-1" force="true"/>
        <env name="AWS_BUCKET" value="filament" force="true"/>
        <env name="AWS_ENDPOINT" value="http://minio:9000" force="true"/>
        <env name="AWS_USE_PATH_STYLE_ENDPOINT" value="true" force="true"/>
        <env name="AWS_URL" value="http://localhost:9000/filament" force="true"/>
        <!-- PASSPORT_* PEMs: tests/Fixtures/oauth/*.key, injected in Tests\TestCase (not production secrets). -->
    </php>
</phpunit>
